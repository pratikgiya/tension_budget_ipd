# ── TensionBudget Cloud Synchronization Environment Settings ──
# INSTRUCTIONS FOR TEAM MEMBERS & COLLABORATORS:
# 1. Copy this file and save it as `.env` in the repository root (do NOT check `.env` into Git).
# 2. Ask the project lead for the public Supabase Anon Key and paste it below.
# 3. All local Python scripts and GUI sync hooks will automatically read credentials from `.env`.

# Public HTTP Endpoint for Serverless Edge Function Ingestion (Port 443 HTTPS - Firewall Bypass)
SUPABASE_EDGE_URL=https://khsrpxzckidhmzdpihfu.supabase.co/functions/v1/ingest-session

# Public Supabase Anon Key (Authenticates gateway traffic before user-password validation)
SUPABASE_ANON_KEY=paste_project_anon_key_here

# Optional: Direct PostgreSQL Connection URI (Only needed if using explicit --direct bypass flag)
# SUPABASE_DB_URI=postgresql://postgres.khsrpxzckidhmzdpihfu:secret@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
